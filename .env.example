SERVER_PORT=9090
SERVER_ADDRESS=127.0.0.1
DB_USERNAME=dovideo
# Fresh Compose installs create this account; keep it equal to DB_USERNAME.
MYSQL_APP_USER=dovideo
DB_PASSWORD=change-me
DB_URL='jdbc:mysql://localhost:3307/media_db?useSSL=false&serverTimezone=Asia/Shanghai&characterEncoding=utf-8&allowPublicKeyRetrieval=true'
MYSQL_ROOT_PASSWORD=change-root-password
FLYWAY_BASELINE_ON_MIGRATE=true
SILICONFLOW_API_KEY=
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
# Chat provider is independent from Embedding and ASR. Leave CHAT_* unset to keep
# using the legacy SiliconFlow LLM settings below.
# Official DeepSeek example:
# DEEPSEEK_API_KEY=replace-with-deepseek-key
# CHAT_BASE_URL=https://api.deepseek.com
# CHAT_MODEL=deepseek-v4-flash
# Alibaba Cloud Model Studio example (replace region and WorkspaceId):
# CHAT_API_KEY=replace-with-bailian-key
# CHAT_BASE_URL=https://{WorkspaceId}.ap-southeast-1.maas.aliyuncs.com/compatible-mode/v1
# CHAT_MODEL=deepseek-v4-flash
LLM_MODEL=deepseek-ai/DeepSeek-V3.2
LLM_TIMEOUT_SECONDS=300
LLM_INPUT_PRICE_PER_MILLION=0
LLM_OUTPUT_PRICE_PER_MILLION=0
AGENT_MAX_ESTIMATED_COST=0
AGENT_MAX_ROUNDS=2
AGENT_MAX_DURATION_MS=120000
AGENT_MAX_ESTIMATED_TOKENS=50000
AGENT_EVALUATION_ENABLED=false
AI_INTERACTIVE_TIMEOUT_MS=180000
EMBEDDING_MODEL=BAAI/bge-m3
# Optional independent provider overrides; unset values reuse SILICONFLOW_API_KEY/base URL.
# EMBEDDING_API_KEY=replace-with-embedding-key
# EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
# ASR_API_KEY=replace-with-asr-key
# ASR_URL=https://api.siliconflow.cn/v1/audio/transcriptions
ASR_MODEL=TeleAI/TeleSpeechASR
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=change-me
MINIO_ACCESS_KEY=dovideo
MINIO_SECRET_KEY=change-me-now
MINIO_ENDPOINT=http://localhost:9000
MINIO_BUCKET=media
QDRANT_ENABLED=true
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=change-me-qdrant
QDRANT_COLLECTION=video_chunks
YTDLP_PATH=yt-dlp
FFMPEG_DIR=
OCR_COMMAND=tesseract
# 用户级 B 站 Cookie 的 AES-GCM 加密密钥（base64 编码的 32 字节；生成：openssl rand -base64 32）。
# 留空则「设置页保存 Cookie」功能不可用（保存会报错、读取返回空），其余导入功能不受影响。
BILIBILI_COOKIE_KEY=
ROCKETMQ_NAME_SERVER=127.0.0.1:9876
VITE_API_BASE_URL=
VITE_DEV_PROXY_TARGET=http://localhost:9090
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
